<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Production Monitor | Auto Sounding</title>
<style>
:root{--bg:#0b1220;--panel:#111c2e;--panel2:#17243a;--line:#263750;--text:#e8eef8;--muted:#91a3bb;--blue:#55a6ff;--green:#35c98a;--red:#ff6b75;--amber:#f4b84a;--shadow:0 12px 32px #0003}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#0a1220,#101c30 55%,#0b1424);color:var(--text);font:14px/1.45 Inter,system-ui,Segoe UI,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:10px 14px;background:var(--blue);color:#071426;font-weight:700}button.secondary{background:#263954;color:var(--text);border:1px solid #354a67}button.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}button.danger{background:#512832;color:#ffd9dd;border:1px solid #793a45}button:disabled{opacity:.45;cursor:not-allowed}.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}.sidebar{background:#0b1423;border-right:1px solid var(--line);padding:22px 15px;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 24px}.brandmark{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#55a6ff,#35c98a);display:grid;place-items:center;color:#061426;font-weight:900;font-size:18px}.brand b{display:block;font-size:15px}.brand small{color:var(--muted)}.navlabel{font-size:10px;letter-spacing:1.5px;color:#647891;padding:12px 10px 7px}.nav button{width:100%;text-align:left;background:transparent;color:#aab9cc;padding:11px 12px;margin:3px 0;border:1px solid transparent;font-weight:600}.nav button.active,.nav button:hover{background:#172943;color:white;border-color:#294360}.nav button span{display:inline-block;width:25px;color:var(--blue)}.sidefoot{position:absolute;bottom:18px;left:20px;right:20px;color:#6f829b;font-size:11px}.main{min-width:0;padding:26px 30px 50px;max-width:1600px;width:100%;margin:auto}.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:25px}.eyebrow{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase}.topbar h1{font-size:25px;margin:4px 0 0}.topright{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.pill{border:1px solid var(--line);background:#132138;color:#b9c9dc;padding:8px 11px;border-radius:10px;font-size:12px}.live{color:var(--green)}.page{display:none}.page.active{display:block}.grid{display:grid;gap:15px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:17px}.card{background:linear-gradient(180deg,#142239,#111c2e);border:1px solid var(--line);border-radius:16px;padding:17px;box-shadow:var(--shadow);min-width:0}.statlabel{color:var(--muted);font-size:12px}.statvalue{font-size:29px;font-weight:800;letter-spacing:-1px;margin-top:7px}.statnote{color:#71859f;font-size:11px;margin-top:4px}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:22px 0 12px}.sectionhead h2{font-size:16px;margin:0}.sectionhead p{color:var(--muted);font-size:12px;margin:3px 0 0}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.field{display:flex;flex-direction:column;gap:5px;min-width:0}.field label{color:#9eb0c7;font-size:11px;font-weight:700}.field input,.field select,.field textarea,input,select,textarea{background:#0d192b;border:1px solid #30435f;color:var(--text);padding:10px 11px;border-radius:9px;outline:none;min-width:0}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55a6ff20}.field textarea{resize:vertical;min-height:68px}.filters{display:flex;gap:10px;align-items:end;flex-wrap:wrap}.filters .field{min-width:150px}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:720px}th,td{padding:11px 12px;text-align:left;border-bottom:1px solid #263750;white-space:nowrap}th{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:#8fa3bc;background:#101c2e;position:sticky;top:0}td{font-size:12px;color:#d8e2ef}tr:last-child td{border-bottom:0}tbody tr:hover{background:#1a2a42}.status{display:inline-flex;align-items:center;gap:6px;border-radius:30px;padding:4px 8px;font-size:10px;font-weight:800}.status.ok{background:#123b32;color:#65e0ad}.status.bad{background:#45242d;color:#ff9da5}.status.wait{background:#3d3420;color:#f4cc72}.status.neutral{background:#26354a;color:#a9bdd4}.dot{width:6px;height:6px;border-radius:50%;background:currentColor}.linegrid{grid-template-columns:repeat(3,minmax(0,1fr))}.linecard{padding:14px}.linehead{display:flex;justify-content:space-between;align-items:center}.linehead strong{font-size:15px}.metric{font-size:23px;font-weight:800;margin:12px 0 2px}.progress{height:6px;border-radius:9px;background:#263750;overflow:hidden;margin:10px 0}.progress i{display:block;height:100%;background:var(--green);border-radius:9px}.muted{color:var(--muted)}.small{font-size:11px}.twocol{grid-template-columns:1.1fr .9fr}.formgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.formgrid .wide{grid-column:span 2}.formgrid .full{grid-column:1/-1}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.notice{border:1px solid #66542e;background:#322b1d;color:#f2d58c;border-radius:11px;padding:11px 13px;font-size:12px;margin:12px 0}.soundbox{background:#0d192b;border:1px solid #2b4261;border-radius:12px;padding:15px;white-space:pre-wrap;min-height:150px;color:#dce9f8;font-size:13px}.tag{font-size:10px;border:1px solid #334963;border-radius:6px;padding:3px 6px;color:#9db1ca}.empty{text-align:center;padding:35px;color:#8295ad}.hidden{display:none!important}.modalback{position:fixed;inset:0;background:#020711bb;display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.modalback.show{display:flex}.modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:#132138;border:1px solid #3a506d;border-radius:17px;padding:20px;box-shadow:0 25px 70px #0008}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.modalhead h3{margin:0}.close{background:transparent;color:#aabbd0;border:1px solid var(--line);padding:5px 10px}.repairrow{display:grid;grid-template-columns:1fr 100px 1.5fr auto;gap:8px;margin:8px 0}.footerhint{color:#6e829d;font-size:11px;margin-top:15px}.mobilemenu{display:none}
@media(max-width:1000px){.app{grid-template-columns:205px 1fr}.main{padding:22px 18px}.stats{grid-template-columns:repeat(2,1fr)}.linegrid{grid-template-columns:repeat(2,1fr)}.formgrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.app{display:block}.sidebar{height:auto;position:relative;padding:12px;border-right:0;border-bottom:1px solid var(--line)}.brand{padding:2px 5px 10px}.nav{display:flex;overflow:auto;gap:5px}.navlabel,.sidefoot{display:none}.nav button{white-space:nowrap;width:auto;padding:9px 10px}.nav button span{width:auto;margin-right:5px}.main{padding:18px 12px}.topbar{align-items:flex-start}.topbar h1{font-size:21px}.topright{justify-content:flex-end}.stats{gap:9px}.card{padding:13px}.statvalue{font-size:24px}.linegrid{grid-template-columns:1fr 1fr}.formgrid{grid-template-columns:1fr 1fr}.formgrid .wide{grid-column:span 2}.twocol{grid-template-columns:1fr}.repairrow{grid-template-columns:1fr 80px}.repairrow textarea{grid-column:1/-1}.repairrow button{grid-column:2}.filters .field{flex:1;min-width:130px}}
@media(max-width:420px){.linegrid{grid-template-columns:1fr}.topright .pill{display:none}.formgrid{grid-template-columns:1fr}.formgrid .wide{grid-column:auto}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="brand"><div class="brandmark">PM</div><div><b>Production Monitor</b><small>Auto Sounding System</small></div></div>
  <div class="navlabel">WORKSPACE</div>
  <nav class="nav">
    <button class="active" data-page="dashboard"><span>▦</span> Dashboard</button>
    <button data-page="input"><span>✎</span> Input Produksi</button>
    <button data-page="orders"><span>▤</span> Order & Target</button>
    <button data-page="sounding"><span>◖</span> Auto Sounding</button>
    <button data-page="history"><span>◷</span> Database / Riwayat</button>
    <button data-page="settings"><span>⚙</span> Pengaturan</button>
  </nav>
  <div class="sidefoot">MVP v0.1 · Penyimpanan lokal perangkat</div>
</aside>
<main class="main">
<header class="topbar"><div><div class="eyebrow">Factory operations</div><h1 id="pageTitle">Dashboard Produksi</h1></div><div class="topright"><span class="pill live">● Sistem aktif</span><span class="pill" id="todayLabel">—</span></div></header>

<section class="page active" id="page-dashboard">
  <div class="filters" style="margin-bottom:15px"><div class="field"><label>Tanggal produksi</label><input type="date" id="dashDate"></div><div class="field"><label>Periode</label><select id="dashPeriod"></select></div><button class="secondary" id="refreshDash">↻ Perbarui</button></div>
  <div class="grid stats">
    <div class="card"><div class="statlabel">Total line</div><div class="statvalue" id="statLines">21</div><div class="statnote">Line aktif A1–A21</div></div>
    <div class="card"><div class="statlabel">Target tercapai</div><div class="statvalue" style="color:var(--green)" id="statOk">0</div><div class="statnote">Output ≥ target</div></div>
    <div class="card"><div class="statlabel">Belum tercapai</div><div class="statvalue" style="color:var(--red)" id="statBad">0</div><div class="statnote">Output &lt; target</div></div>
    <div class="card"><div class="statlabel">Belum diinput</div><div class="statvalue" style="color:var(--amber)" id="statWait">21</div><div class="statnote">Menunggu data produksi</div></div>
  </div>
  <div class="grid twocol">
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Monitoring per line</h2><p id="dashSub">Status periode produksi terpilih</p></div><span class="tag" id="dayScheduleTag">Jadwal normal</span></div><div class="grid linegrid" id="lineCards"></div></div>
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Ringkasan sounding</h2><p>Pratinjau teks periode terpilih</p></div><button class="secondary" id="goSound">Buka sounding</button></div><div class="soundbox" id="dashSoundText">Belum ada data produksi untuk periode ini.</div><div class="footerhint">Data simulasi dan input tersimpan pada browser ini.</div></div>
  </div>
</section>

<section class="page" id="page-input">
  <div class="card">
    <div class="sectionhead" style="margin-top:0"><div><h2>Input output per jam</h2><p>Setiap periode berdiri sendiri, bukan akumulasi.</p></div><span class="tag">21 line</span></div>
    <div class="filters" style="margin-bottom:16px">
      <div class="field"><label>Tanggal</label><input type="date" id="inputDate"></div>
      <div class="field"><label>Periode produksi</label><select id="inputPeriod"></select></div>
      <div class="field"><label>Filter line</label><select id="inputLineFilter"><option value="all">Semua line</option></select></div>
      <button class="secondary" id="loadInput">Muat data</button>
    </div>
    <div class="notice" id="scheduleNotice">Jadwal produksi menyesuaikan hari yang dipilih.</div>
    <div class="tablewrap"><table><thead><tr><th>Line</th><th>Order / Model</th><th>Target</th><th>Output</th><th>Operator</th><th>Repair / Kendala</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="inputRows"></tbody></table></div>
    <div class="actions"><button id="saveAll">Simpan semua perubahan</button><button class="secondary" id="clearPeriod">Kosongkan draft periode</button></div>
    <div class="footerhint">Tip: klik Edit pada baris untuk mengisi output, operator, dan detail repair. Target otomatis mengikuti order aktif dan bisa diedit per periode.</div>
  </div>
</section>

<section class="page" id="page-orders">
  <div class="grid twocol">
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Order & target aktif</h2><p>Target standar per line mengikuti order.</p></div><button id="addOrder">+ Tambah order</button></div><div class="tablewrap"><table><thead><tr><th>Line</th><th>Order</th><th>Model</th><th>Target / jam</th><th>Aksi</th></tr></thead><tbody id="orderRows"></tbody></table></div></div>
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Petunjuk target</h2><p>Perubahan order tidak mengubah histori.</p></div></div><div class="notice">Target standar diambil saat membuat catatan produksi. Jika order sama, target otomatis terisi. Target pada catatan jam tertentu tetap dapat diedit tanpa mengubah master order.</div><div class="field"><label>Daftar operator (pisahkan dengan koma)</label><textarea id="operatorList" placeholder="Andi, Budi, Citra"></textarea></div><div class="actions"><button id="saveOperators">Simpan daftar operator</button></div><div class="footerhint">Nama operator bisa dipilih pada form input produksi.</div></div>
  </div>
</section>

<section class="page" id="page-sounding">
  <div class="grid twocol">
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Sounding controller</h2><p>Generator kalimat dan pemutar suara.</p></div><span class="status neutral" id="soundStatus">SIAP</span></div>
      <div class="filters"><div class="field"><label>Tanggal</label><input type="date" id="soundDate"></div><div class="field"><label>Periode</label><select id="soundPeriod"></select></div><button class="secondary" id="generateSound">Buat teks</button></div>
      <div class="notice" id="soundNotice">Sounding jam pertama menyebutkan hari dan tanggal. Periode berikutnya langsung menyebutkan jam.</div>
      <div class="soundbox" id="soundText" contenteditable="true" spellcheck="false">Pilih tanggal dan periode, lalu klik Buat teks.</div>
      <div class="actions"><button id="playSound">▶ Putar sounding</button><button class="secondary" id="pauseSound">Ⅱ Jeda</button><button class="secondary" id="resumeSound">Lanjut</button><button class="danger" id="stopSound">■ Stop</button></div>
      <div class="footerhint">Suara menggunakan fitur text-to-speech browser. Pastikan komputer sounding terhubung ke speaker.</div>
    </div>
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Validasi sebelum sounding</h2><p>Pastikan data periode sudah lengkap.</p></div></div><div id="soundValidation"></div><div class="actions"><button class="secondary" id="markSounded">Tandai selesai sounding</button></div><div class="footerhint">MVP ini belum menjalankan scheduler otomatis saat browser ditutup. Jadwal otomatis lintas perangkat memerlukan server dan sounding station khusus.</div></div>
  </div>
</section>

<section class="page" id="page-history">
  <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Database produksi</h2><p>Riwayat catatan produksi per line dan per jam.</p></div><button id="exportCsv">↓ Export CSV</button></div><div class="filters" style="margin-bottom:14px"><div class="field"><label>Dari tanggal</label><input type="date" id="historyFrom"></div><div class="field"><label>Sampai tanggal</label><input type="date" id="historyTo"></div><div class="field"><label>Line</label><select id="historyLine"><option value="all">Semua line</option></select></div><button class="secondary" id="filterHistory">Terapkan filter</button></div><div class="tablewrap"><table><thead><tr><th>Tanggal</th><th>Jam</th><th>Line</th><th>Order</th><th>Target</th><th>Output</th><th>Operator</th><th>Repair</th><th>Status</th></tr></thead><tbody id="historyRows"></tbody></table></div><div class="footerhint" id="historyCount">0 catatan</div></div>
</section>

<section class="page" id="page-settings">
  <div class="grid twocol">
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Jadwal kerja</h2><p>Interval produksi 60 menit.</p></div></div><div id="scheduleSettings"></div></div>
    <div class="card"><div class="sectionhead" style="margin-top:0"><div><h2>Pengaturan aplikasi</h2><p>Data demo dan backup perangkat.</p></div></div><div class="notice">Data versi MVP disimpan di local storage browser. Data tidak otomatis tersinkron ke komputer lain.</div><div class="actions"><button class="secondary" id="backupData">Export backup JSON</button><label class="secondary" style="padding:10px 14px;border-radius:10px;cursor:pointer">Import backup JSON<input type="file" id="importData" accept="application/json" hidden></label><button class="danger" id="resetData">Reset seluruh data</button></div><div class="footerhint">Jangan reset sebelum membuat backup. Integrasi Supabase akan menambahkan login, database bersama, dan sinkronisasi realtime.</div></div>
  </div>
</section>
</main>
</div>

<div class="modalback" id="editModal"><div class="modal"><div class="modalhead"><h3 id="modalTitle">Input produksi</h3><button class="close" id="closeModal">✕</button></div><div id="modalBody"></div><div class="actions"><button id="saveRecord">Simpan catatan</button><button class="secondary" id="cancelModal">Batal</button></div></div></div>
<script>
const $=s=>document.querySelector(s); const $$=s=>[...document.querySelectorAll(s)];
const STORAGE='production-monitor-mvp-v1';
const lines=Array.from({length:21},(_,i)=>`A${i+1}`);
const schedules={
  normal:{label:'Senin–Kamis',periods:[['Jam ke-1','07:30','08:30',true],['Jam ke-2','08:30','09:30',true],['Jam ke-3','09:30','10:30',true],['Jam ke-4','10:30','11:30',true],['Jam ke-5','12:30','13:30',true],['Jam ke-6','13:30','14:30',true],['Jam ke-7','14:30','15:30',false]]},
  friday:{label:'Jumat',periods:[['Jam ke-1','07:30','08:30',true],['Jam ke-2','08:30','09:30',true],['Jam ke-3','09:30','10:30',true],['Jam ke-4','10:30','11:30',true],['Jam ke-5','11:30','12:30',true],['Jam ke-6','13:00','14:00',true],['Jam ke-7','14:00','15:00',true],['Jam ke-8','15:00','16:00',false]]},
  saturday:{label:'Sabtu',periods:[['Jam ke-1','07:30','08:30',true],['Jam ke-2','08:30','09:30',true],['Jam ke-3','09:30–10:00 & 10:30–11:00','60 menit total',true],['Jam ke-4','11:00','12:00',true],['Jam ke-5','12:00','13:00',false]]}
};
function dayType(date){const d=new Date(date+'T12:00:00').getDay();return d===5?'friday':d===6?'saturday':'normal'}
function dateID(d=new Date()){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function seed(){return {orders:Object.fromEntries(lines.map((l,i)=>[l,{orderCode:'',model:'',target:0}])),operators:['Andi','Budi','Citra'],records:{},soundLogs:[]}}
let db=loadDB();function loadDB(){try{return {...seed(),...JSON.parse(localStorage.getItem(STORAGE)||'{}')}}catch(e){return seed()}}
function saveDB(){localStorage.setItem(STORAGE,JSON.stringify(db))}
function fmtDate(s){if(!s)return '';return new Date(s+'T12:00:00').toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}
function periodList(date){return schedules[dayType(date)].periods}
function populatePeriods(sel,date,selected){sel.innerHTML='';periodList(date).forEach((p,i)=>{const o=document.createElement('option');o.value=i;o.textContent=`${p[0]} · ${p[1]}–${p[2]}`;sel.append(o)});if(selected!==undefined&&selected<sel.options.length)sel.value=selected}
function recKey(date,period,line){return `${date}|${period}|${line}`}
function getRec(date,period,line){return db.records[recKey(date,period,line)]||null}
function getOrder(line){return db.orders[line]||{orderCode:'',model:'',target:0}}
function statusOf(r){if(!r)return 'wait';if(Number(r.target)<=0)return 'neutral';return Number(r.output)>=Number(r.target)?'ok':'bad'}
function statusHTML(s){return s==='ok'?'<span class="status ok"><i class="dot"></i>Tercapai</span>':s==='bad'?'<span class="status bad"><i class="dot"></i>Belum tercapai</span>':s==='neutral'?'<span class="status neutral">Target belum ada</span>':'<span class="status wait">Belum diinput</span>'}
function initDateControls(){const today=dateID();['dashDate','inputDate','soundDate','historyFrom','historyTo'].forEach(id=>{const el=$('#'+id);if(el&&!el.value)el.value=today});$('#dashDate').value=today;$('#inputDate').value=today;$('#soundDate').value=today;$('#historyFrom').value=today;$('#historyTo').value=today;['dashPeriod','inputPeriod','soundPeriod'].forEach(id=>populatePeriods($('#'+id),today,0));
  const opts=lines.map(l=>`<option value="${l}">${l}</option>`).join('');$('#inputLineFilter').insertAdjacentHTML('beforeend',opts);$('#historyLine').insertAdjacentHTML('beforeend',opts);
}
function refreshPeriods(date){['dashPeriod','inputPeriod','soundPeriod'].forEach(id=>{const old=Number($('#'+id).value)||0;populatePeriods($('#'+id),date,old)})}
function renderDashboard(){const date=$('#dashDate').value,pi=Number($('#dashPeriod').value)||0,period=periodList(date)[pi];if(!period)return;const rows=lines.map(l=>({line:l,r:getRec(date,pi,l),o:getOrder(l)}));const counts={ok:0,bad:0,wait:0,neutral:0};rows.forEach(x=>counts[statusOf(x.r)]++);$('#statLines').textContent=21;$('#statOk').textContent=counts.ok;$('#statBad').textContent=counts.bad;$('#statWait').textContent=counts.wait+counts.neutral;$('#dashSub').textContent=`${fmtDate(date)} · ${period[0]} (${period[1]}–${period[2]})`;
$('#dayScheduleTag').textContent=schedules[dayType(date)].label;$('#lineCards').innerHTML=rows.map(({line,r,o})=>{const st=statusOf(r),t=Number(r?.target??o.target)||0,v=Number(r?.output)||0,p=t?Math.min(100,v/t*100):0;return `<div class="card linecard"><div class="linehead"><strong>${line}</strong>${statusHTML(st)}</div><div class="metric">${r?v:'—'} <span class="muted small">/ ${r?t||'—':o.target||'Target?'}</span></div><div class="progress"><i style="width:${p}%;background:${st==='bad'?'var(--red)':'var(--green)'}"></i></div><div class="small muted">${r?(t?Math.round(v/t*100)+'% pencapaian':'Target belum diatur'):(o.model||'Order belum diatur')}</div></div>`}).join('');$('#dashSoundText').textContent=generateText(date,pi,false).text||'Belum ada data produksi untuk periode ini.'}
function renderInput(){const date=$('#inputDate').value,pi=Number($('#inputPeriod').value)||0,filter=$('#inputLineFilter').value;const periods=periodList(date),p=periods[pi];if(!p)return;$('#scheduleNotice').textContent=`${schedules[dayType(date)].label}: ${p[0]} · ${p[1]}–${p[2]}. Output dicatat khusus untuk periode ini.`;const rows=lines.filter(l=>filter==='all'||l===filter).map(l=>{const r=getRec(date,pi,l),o=getOrder(l),st=statusOf(r);return `<tr><td><b>${l}</b></td><td>${r?.model||o.model||'—'} <span class="muted">${r?.orderCode||o.orderCode||''}</span></td><td>${r?.target??(o.target||'—')}</td><td><b>${r?.output??'—'}</b></td><td>${(r?.operators||[]).join(', ')||'—'}</td><td>${r?.repairs?.length?`${r.repairs.length} kendala`:'—'}</td><td>${statusHTML(st)}</td><td><button class="secondary" data-edit="${l}" style="padding:6px 9px">${r?'Edit':'Input'}</button></td></tr>`}).join('');$('#inputRows').innerHTML=rows||'<tr><td colspan="8" class="empty">Tidak ada line.</td></tr>';$$('[data-edit]').forEach(b=>b.addEventListener('click',()=>openEditor(date,pi,b.dataset.edit)))}
let editing=null;
function openEditor(date,pi,line){editing={date,pi,line};const r=getRec(date,pi,line)||{},o=getOrder(line);$('#modalTitle').textContent=`Input produksi · ${line} · ${periodList(date)[pi][0]}`;const operators=db.operators.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');const selected=r.operators||[];$('#modalBody').innerHTML=`<div class="formgrid"><div class="field"><label>Order code</label><input id="eOrder" value="${esc(r.orderCode??o.orderCode)}" placeholder="Contoh: ORD-001"></div><div class="field"><label>Model / produk</label><input id="eModel" value="${esc(r.model??o.model)}" placeholder="Nama model"></div><div class="field"><label>Target per jam</label><input id="eTarget" type="number" min="0" value="${r.target??o.target??''}"></div><div class="field"><label>Output periode ini</label><input id="eOutput" type="number" min="0" value="${r.output??''}" placeholder="Masukkan output"></div><div class="field wide"><label>Operator (bisa pilih lebih dari satu)</label><select id="eOperators" multiple size="4">${operators}</select><div class="small muted">Gunakan Ctrl (Windows) untuk memilih lebih dari satu.</div></div><div class="field"><label>Catatan umum</label><input id="eNote" value="${esc(r.note||'')}" placeholder="Opsional"></div><div class="field full"><label>Repair / kendala</label><div id="repairList"></div><button class="secondary" type="button" id="addRepair" style="margin-top:8px">+ Tambah kendala</button></div></div>`;
  const sel=$('#eOperators');[...sel.options].forEach(op=>op.selected=selected.includes(op.value));const repairList=$('#repairList');(r.repairs?.length?r.repairs:[{type:'',minutes:'',notes:''}]).forEach(x=>addRepairRow(x));$('#addRepair').onclick=()=>addRepairRow();$('#editModal').classList.add('show');}
function addRepairRow(v={}){const row=document.createElement('div');row.className='repairrow';row.innerHTML=`<select class="rType"><option value="">Pilih kendala</option>${['Banyak repair','Mesin trouble','Ganti part','Sensor bermasalah','Material terlambat','Setting mesin','Menunggu teknisi','Kendala kualitas','Kendala lainnya'].map(x=>`<option ${v.type===x?'selected':''}>${x}</option>`).join('')}</select><input class="rMinutes" type="number" min="0" placeholder="Menit" value="${v.minutes??''}"><textarea class="rNotes" placeholder="Keterangan repair">${esc(v.notes||'')}</textarea><button class="danger removeRepair" type="button">×</button>`;row.querySelector('.removeRepair').onclick=()=>row.remove();$('#repairList').append(row)}
function closeEditor(){$('#editModal').classList.remove('show');editing=null}
function saveEditor(){if(!editing)return;const {date,pi,line}=editing;const target=Number($('#eTarget').value),output=$('#eOutput').value;if(!Number.isFinite(target)||target<=0){alert('Target harus diisi lebih dari 0.');return}if(output===''||!Number.isFinite(Number(output))||Number(output)<0){alert('Output harus diisi dengan angka 0 atau lebih.');return}const repairs=$$('.repairrow').map(row=>({type:row.querySelector('.rType').value,minutes:Number(row.querySelector('.rMinutes').value)||0,notes:row.querySelector('.rNotes').value.trim()})).filter(x=>x.type||x.notes||x.minutes);if(Number(output)<target&&!repairs.length&&!$('#eNote').value.trim()){if(!confirm('Output di bawah target tetapi belum ada kendala/repair. Simpan sebagai perlu klarifikasi?'))return}
 const operators=[...$('#eOperators').selectedOptions].map(x=>x.value);db.records[recKey(date,pi,line)]={date,period:pi,line,orderCode:$('#eOrder').value.trim(),model:$('#eModel').value.trim(),target,output:Number(output),operators,repairs,note:$('#eNote').value.trim(),updatedAt:new Date().toISOString()};saveDB();closeEditor();renderInput();renderDashboard();}
function generateText(date,pi,strict=true){const p=periodList(date)[pi];if(!p)return {text:'Periode tidak tersedia.',missing:[]};const rows=lines.map(l=>({line:l,r:getRec(date,pi,l)}));const missing=rows.filter(x=>!x.r);let text=pi===0?`Pencapaian target line, hari ${fmtDate(date)}.`:`Pencapaian target line ${p[0].toLowerCase()}.`;for(const {line,r} of rows){if(!r){text+=`\n${line}, data belum diinput.`;continue}const repairs=r.repairs||[];const cause=repairs.map(x=>{let s=x.type||'kendala';if(x.notes)s+=`, ${x.notes}`;if(x.minutes)s+=`, repair ${x.minutes} menit`;return s}).join('; ');if(Number(r.output)>=Number(r.target)){text+=`\nLine ${line}, target ${r.target}, output ${r.output}, target tercapai.`}else{const reason=cause||r.note||'penyebab belum diinput';text+=`\nLine ${line}, target ${r.target}, output ${r.output}, dikarenakan ${reason}, target tidak tercapai.`}}return {text,missing}}
function renderSounding(){const date=$('#soundDate').value,pi=Number($('#soundPeriod').value)||0;const result=generateText(date,pi);$('#soundText').textContent=result.text;const p=periodList(date)[pi];const missing=result.missing.length;$('#soundNotice').textContent=`${schedules[dayType(date)].label} · ${p[0]} · ${p[1]}–${p[2]} · ${p[3]?'Sounding diizinkan':'Periode terakhir: sounding dinonaktifkan'}`;const soundable=p[3];$('#playSound').disabled=!soundable;$('#markSounded').disabled=!soundable;$('#soundValidation').innerHTML=`<div class="card" style="padding:12px;margin-bottom:9px"><div class="statlabel">Data belum diinput</div><div class="statvalue" style="font-size:25px;color:${missing?'var(--amber)':'var(--green)'}">${missing} / 21</div></div>${missing?`<div class="notice">Masih ada ${missing} line belum diinput. Teks sounding akan menyebut data belum diinput.</div>`:'<div class="status ok">Semua line sudah memiliki data</div>'}${!soundable?'<div class="notice">Sounding otomatis dinonaktifkan untuk periode terakhir. Data tetap bisa direkap.</div>':''}<p class="small muted">Pastikan penyebab ketidaktercapaian sudah dicatat sebelum sounding final.</p>`;$('#soundStatus').textContent=soundable?'SIAP':'SOUNDING OFF';$('#soundStatus').className='status '+(soundable?'neutral':'wait')}
function renderOrders(){$('#orderRows').innerHTML=lines.map(l=>{const o=getOrder(l);return `<tr><td><b>${l}</b></td><td>${esc(o.orderCode||'—')}</td><td>${esc(o.model||'—')}</td><td>${o.target||'—'}</td><td><button class="secondary" data-order="${l}" style="padding:6px 9px">Atur</button></td></tr>`}).join('');$$('[data-order]').forEach(b=>b.onclick=()=>{const l=b.dataset.order,o=getOrder(l);const orderCode=prompt(`Order code untuk ${l}`,o.orderCode||'');if(orderCode===null)return;const model=prompt(`Model / produk untuk ${l}`,o.model||'');if(model===null)return;const target=prompt(`Target standar per jam untuk ${l}`,o.target||'');if(target===null)return;if(Number(target)<=0||!Number.isFinite(Number(target))){alert('Target harus lebih dari 0');return}db.orders[l]={orderCode,model,target:Number(target)};saveDB();renderOrders();renderDashboard()});$('#operatorList').value=db.operators.join(', ')}
function renderHistory(){const from=$('#historyFrom').value,to=$('#historyTo').value,line=$('#historyLine').value;const rows=Object.values(db.records).filter(r=>(!from||r.date>=from)&&(!to||r.date<=to)&&(line==='all'||r.line===line)).sort((a,b)=>b.date.localeCompare(a.date)||a.period-b.period||a.line.localeCompare(b.line,undefined,{numeric:true}));$('#historyRows').innerHTML=rows.map(r=>`<tr><td>${r.date}</td><td>${periodList(r.date)[r.period]?.[0]||'—'}</td><td><b>${r.line}</b></td><td>${esc(r.model||r.orderCode||'—')}</td><td>${r.target}</td><td>${r.output}</td><td>${esc((r.operators||[]).join(', ')||'—')}</td><td>${esc((r.repairs||[]).map(x=>x.type+(x.minutes?' '+x.minutes+'m':'')).join('; ')||'—')}</td><td>${statusHTML(statusOf(r))}</td></tr>`).join('')||'<tr><td colspan="9" class="empty">Belum ada data pada rentang tanggal ini.</td></tr>';$('#historyCount').textContent=`${rows.length} catatan produksi`}
function renderSettings(){$('#scheduleSettings').innerHTML=Object.entries(schedules).map(([k,s])=>`<div style="margin-bottom:16px"><b>${s.label}</b><div class="small muted">${s.periods.length} periode · sounding periode terakhir nonaktif</div><div class="small" style="margin-top:5px">${s.periods.map(p=>`${p[0]}: ${p[1]}–${p[2]}${p[3]?'':' (sound off)'}`).join('<br>')}</div></div>`).join('')}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showPage(name){$$('.page').forEach(p=>p.classList.toggle('active',p.id===`page-${name}`));$$('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===name));const titles={dashboard:'Dashboard Produksi',input:'Input Produksi',orders:'Order & Target',sounding:'Auto Sounding',history:'Database / Riwayat',settings:'Pengaturan'};$('#pageTitle').textContent=titles[name];if(name==='dashboard')renderDashboard();if(name==='input')renderInput();if(name==='orders')renderOrders();if(name==='sounding')renderSounding();if(name==='history')renderHistory();if(name==='settings')renderSettings()}
function exportCSV(){const rows=Object.values(db.records);const head=['tanggal','periode','line','order_code','model','target','output','operator','repair','catatan'];const data=rows.map(r=>[r.date,periodList(r.date)[r.period]?.[0]||'',r.line,r.orderCode,r.model,r.target,r.output,(r.operators||[]).join('; '),(r.repairs||[]).map(x=>`${x.type} ${x.minutes} menit ${x.notes}`).join('; '),r.note]);const csv=[head,...data].map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');download(csv,'production-history.csv','text/csv;charset=utf-8')}
function download(content,name,type){const a=document.createElement('a');const url=URL.createObjectURL(new Blob([content],{type}));a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)}
function playText(){const p=periodList($('#soundDate').value)[Number($('#soundPeriod').value)||0];if(!p?.[3]){alert('Sounding dinonaktifkan untuk periode terakhir.');return}if(!('speechSynthesis'in window)){alert('Browser ini tidak mendukung text-to-speech.');return}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance($('#soundText').innerText);u.lang='id-ID';u.rate=0.92;u.pitch=1;u.volume=1;u.onstart=()=>{$('#soundStatus').textContent='PLAYING';$('#soundStatus').className='status ok'};u.onend=()=>{$('#soundStatus').textContent='SELESAI';$('#soundStatus').className='status ok'};speechSynthesis.speak(u)}
// Events
$$('.nav button').forEach(b=>b.onclick=()=>showPage(b.dataset.page));$('#todayLabel').textContent=fmtDate(dateID());$('#goSound').onclick=()=>showPage('sounding');
['dashDate','inputDate','soundDate'].forEach(id=>$('#'+id).addEventListener('change',e=>{refreshPeriods(e.target.value);if(id==='dashDate')renderDashboard();if(id==='inputDate')renderInput();if(id==='soundDate')renderSounding()}));$('#dashPeriod').onchange=renderDashboard;$('#inputPeriod').onchange=renderInput;$('#soundPeriod').onchange=renderSounding;$('#inputLineFilter').onchange=renderInput;$('#refreshDash').onclick=renderDashboard;$('#loadInput').onclick=renderInput;$('#saveAll').onclick=()=>{saveDB();alert('Data yang sudah disimpan per baris tersimpan di browser ini.');renderInput();renderDashboard()};$('#clearPeriod').onclick=()=>{const d=$('#inputDate').value,p=Number($('#inputPeriod').value)||0;if(!confirm('Hapus seluruh catatan pada periode ini?'))return;lines.forEach(l=>delete db.records[recKey(d,p,l)]);saveDB();renderInput();renderDashboard()};$('#closeModal').onclick=closeEditor;$('#cancelModal').onclick=closeEditor;$('#saveRecord').onclick=saveEditor;$('#editModal').onclick=e=>{if(e.target.id==='editModal')closeEditor()};
$('#addOrder').onclick=()=>{const l=prompt('Masukkan line (A1 sampai A21):');if(!lines.includes((l||'').toUpperCase())){if(l)alert('Line tidak valid.');return}const code=prompt('Order code:')??'';const model=prompt('Nama model / produk:')??'';const target=Number(prompt('Target standar per jam:'));if(!Number.isFinite(target)||target<=0){alert('Target tidak valid.');return}db.orders[l.toUpperCase()]={orderCode:code,model,target};saveDB();renderOrders()};$('#saveOperators').onclick=()=>{db.operators=$('#operatorList').value.split(',').map(x=>x.trim()).filter(Boolean);saveDB();alert('Daftar operator disimpan.')};$('#generateSound').onclick=renderSounding;$('#playSound').onclick=playText;$('#pauseSound').onclick=()=>speechSynthesis.pause();$('#resumeSound').onclick=()=>speechSynthesis.resume();$('#stopSound').onclick=()=>{speechSynthesis.cancel();$('#soundStatus').textContent='STOP';$('#soundStatus').className='status neutral'};$('#markSounded').onclick=()=>{const d=$('#soundDate').value,p=Number($('#soundDate').value)||0;if(!periodList(d)[p][3])return;const result=generateText(d,p);db.soundLogs.push({date:d,period:p,text:$('#soundText').innerText,at:new Date().toISOString()});saveDB();alert('Periode ditandai selesai sounding.');};$('#filterHistory').onclick=renderHistory;$('#exportCsv').onclick=exportCSV;$('#backupData').onclick=()=>download(JSON.stringify(db,null,2),'production-monitor-backup.json','application/json');$('#importData').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const x=JSON.parse(await f.text());if(!x.records||!x.orders)throw Error();db={...seed(),...x};saveDB();alert('Backup berhasil diimpor.');location.reload()}catch(err){alert('File backup tidak valid.')}};$('#resetData').onclick=()=>{if(confirm('Yakin reset semua data pada browser ini? Buat backup terlebih dahulu.')){db=seed();saveDB();location.reload()}};
initDateControls();renderDashboard();renderInput();renderOrders();renderSounding();renderHistory();renderSettings();
</script>
</body>
